{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "master": false
    }
  },
  "rewrites": [
    { "source": "/api/food/analyze", "destination": "/api/food" },
    { "source": "/api/ai/insight", "destination": "/api/insight" },
    { "source": "/api/auth/send-code", "destination": "/api/codes?action=send" },
    { "source": "/api/auth/verify-code", "destination": "/api/codes?action=verify" },
    { "source": "/api/notifications/register", "destination": "/api/notify?action=register" },
    { "source": "/api/notifications/device", "destination": "/api/notify?action=device" },
    { "source": "/api/notifications/schedule", "destination": "/api/notify?action=schedule" },
    { "source": "/api/notifications/dispatch", "destination": "/api/notify?action=dispatch" },
    { "source": "/api/daily-summary", "destination": "/api/reports?kind=daily" },
    { "source": "/api/weekly-summary", "destination": "/api/reports?kind=weekly" },
    { "source": "/((?!api/|_expo/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/notify",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
