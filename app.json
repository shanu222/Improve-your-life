{
  "expo": {
    "name": "DailyMe",
    "slug": "dailyme",
    "scheme": "dailyme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F0EA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.daily.wellness",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F0EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "app.daily.wellness",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E85D4C"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F0EA",
          "image": "./assets/splash-icon.png"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "DailyMe uses photos only to estimate a meal. The photo is not stored.",
          "cameraPermission": "DailyMe uses the camera only to estimate a meal. The photo is not stored."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "googleClientId": "",
      "apiBase": "https://improve-your-life-ten.vercel.app",
      "firebase": {
        "apiKey": "AIzaSyBlI951Ve6D7f5JcNzPJQmBGBavvYbk58o",
        "authDomain": "dailyme-e11ef.firebaseapp.com",
        "projectId": "dailyme-e11ef",
        "storageBucket": "dailyme-e11ef.firebasestorage.app",
        "messagingSenderId": "710882308081",
        "appId": "1:710882308081:android:c576eeaa60e3539efb9e50"
      }
    }
  }
}
