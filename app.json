{
  "expo": {
    "name": "DailyMe",
    "slug": "dailyme",
    "scheme": "dailyme",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F0EA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.daily.wellness",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F0EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "app.daily.wellness",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E85D4C"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F0EA",
          "image": "./assets/splash-icon.png"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "DailyMe uses photos only to estimate a meal. The photo is not stored.",
          "cameraPermission": "DailyMe uses the camera only to estimate a meal. The photo is not stored."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3753880887983252~5424402743"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "googleClientId": "710882308081-oapvonsj28kb6u4bfhemvebf99onf96t.apps.googleusercontent.com",
      "googleWebClientId": "710882308081-oapvonsj28kb6u4bfhemvebf99onf96t.apps.googleusercontent.com",
      "googleAndroidClientId": "710882308081-ooov9rapb55apfpkiel54a70eadrr8r3.apps.googleusercontent.com",
      "apiBase": "https://improve-your-life-ten.vercel.app",
      "supportEmail": "shahnawaz9974balouch@gmail.com",
      "legal": {
        "privacyUrl": "https://improve-your-life-ten.vercel.app/privacy-policy",
        "termsUrl": "https://improve-your-life-ten.vercel.app/terms",
        "supportUrl": "https://improve-your-life-ten.vercel.app/support",
        "deleteAccountUrl": "https://improve-your-life-ten.vercel.app/delete-account"
      },
      "firebase": {
        "apiKey": "AIzaSyBlI951Ve6D7f5JcNzPJQmBGBavvYbk58o",
        "authDomain": "dailyme-e11ef.firebaseapp.com",
        "projectId": "dailyme-e11ef",
        "storageBucket": "dailyme-e11ef.firebasestorage.app",
        "messagingSenderId": "710882308081",
        "appId": "1:710882308081:android:c576eeaa60e3539efb9e50"
      }
    }
  }
}
